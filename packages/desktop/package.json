{
  "$schema": "https://json.schemastore.org/package",
  "name": "@pairrank/desktop",
  "productName": "pairrank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "build": "tsdown",
    "start": "tsdown && electron build/main/main.js",
    "smoke": "tsdown && electron build/main/main.js --smoke",
    "installer": "node scripts/installer.ts",
    "e2e": "tsdown && tsx src/e2e/layout.e2e.ts && tsx src/e2e/browse.e2e.ts && tsdown -c tsdown.e2e.config.ts && electron build/e2e/capture.js"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mark1russell7/files": "^0.0.2",
    "@mark1russell7/layout-contract": "^0.10.0",
    "@mark1russell7/text": "^0.0.5",
    "@pairrank/host": "workspace:*",
    "@pairrank/input": "workspace:*",
    "@pairrank/store": "workspace:*",
    "@pairrank/surfaces": "workspace:*",
    "@pairrank/ui": "workspace:*",
    "@procedures/client": "^0.55.2",
    "@procedures/peer": "^0.55.2",
    "electron-updater": "^6.8.11",
    "polite-crawler": "^0.6.0"
  }
}
