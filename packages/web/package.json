{
  "$schema": "https://json.schemastore.org/package",
  "name": "@pairrank/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "build": "tsdown",
    "start": "tsdown && node src/main.ts",
    "e2e": "tsdown && node src/e2e/browser.e2e.ts"
  },
  "dependencies": {
    "@pairrank/host": "workspace:*",
    "@pairrank/store": "workspace:*",
    "@pairrank/surfaces": "workspace:*",
    "@pairrank/ui": "workspace:*",
    "@procedures/browser": "^0.55.0",
    "@procedures/client": "^0.55.0",
    "@procedures/http": "^0.55.0",
    "@procedures/peer": "^0.55.0",
    "@procedures/server": "^0.55.0",
    "polite-crawler": "^0.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/service": "^0.8.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "happy-dom": "^21.0.4",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
